# App
NEXT_PUBLIC_APP_URL=
BLOB_READ_WRITE_TOKEN=
PUBLISH_SIGNING_SECRET=

# Optional signed upsert into a consumer-facing venue map.
LISTING_WEBHOOK_URL=
LISTING_WEBHOOK_SECRET=

# Qwen Cloud / Alibaba Model Studio Pay-As-You-Go compatible endpoint.
# Optional overrides default to:
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.6-flash
# QWEN_REGION=intl
DASHSCOPE_API_KEY=
# Deprecated alias; use DASHSCOPE_API_KEY.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_REGION=
# Optional workspace routing header. Leave empty for the default workspace.
QWEN_WORKSPACE_ID=

# GMI Cloud OpenAI-compatible endpoint.
GMI_API_KEY=
GMI_BASE_URL=
GMI_MODEL=

# ai& OpenAI-compatible endpoint.
AIAND_API_KEY=
AIAND_BASE_URL=
AIAND_MODEL=

# Nosana: optional, never on the critical path.
NOSANA_API_KEY=
NOSANA_MARKET=
NOSANA_JOB_ID=
NOSANA_SUBMIT_SECRET=

# Daytona: optional audit/preview evidence.
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=

# Guard storage (local/test only; production uses private Vercel Blob).
GUARD_STORE_DIR=

# Qwen chat guard.
GUARD_QWEN_CHAT_NATIVE_UNIT=
GUARD_QWEN_CHAT_CONFIRMED_CAP_USD=
GUARD_QWEN_CHAT_SPENT_SNAPSHOT_USD=
GUARD_QWEN_CHAT_SLOT_COST_USD=
GUARD_QWEN_CHAT_MAX_ACTION_COST_USD=
GUARD_QWEN_CHAT_PRICE_SOURCE_URL=
GUARD_QWEN_CHAT_PRICE_EFFECTIVE_DATE=
# enabled, unavailable, or unknown
GUARD_QWEN_CHAT_HARD_LIMIT=
# Required only when HARD_LIMIT=unavailable.
GUARD_QWEN_CHAT_HARD_LIMIT_ACKNOWLEDGED=

